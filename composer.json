{
    "name": "hampel/saasu-api-laravel",
    "description": "Laravel service provider, manager and facade for the Saasu accounting API client, with cached OAuth tokens, a rate limit shared across workers, and Http::fake() support",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/saasu-api-laravel/issues",
        "source": "https://github.com/hampel/saasu-api-laravel"
    },
    "keywords": [
        "saasu",
        "accounting",
        "invoices",
        "api",
        "laravel"
    ],
    "homepage": "https://github.com/hampel/saasu-api-laravel",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "guzzlehttp/psr7": "^2.0|^3.0",
        "hampel/saasu-api": "^0.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.4.2",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\Saasu\\Api\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\Saasu\\Api\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hampel\\Saasu\\Api\\Laravel\\SaasuServiceProvider"
            ],
            "aliases": {
                "Saasu": "Hampel\\Saasu\\Api\\Laravel\\Facades\\Saasu"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
